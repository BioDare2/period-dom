<settings>
  <servers>
    <server>
      <id>nexus</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>
  </servers>

  <mirrors>
    <mirror>
      <id>unblock-http</id>
      <mirrorOf>maven-default-http-blocker</mirrorOf>
      <name>Unblock HTTP</name>
      <url>http://0.0.0.0/</url>
      <blocked>false</blocked>
    </mirror>

    <mirror>
      <id>nexus-mirror</id>
      <mirrorOf>*</mirrorOf>
      <name>Nexus on tomato</name>
      <url>http://tomato.bio.ed.ac.uk:8883/repository/biodare/</url>
    </mirror>
  </mirrors>
</settings>
